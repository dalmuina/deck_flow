# Copy this file to `keystore.properties` (git-ignored) on machines that build
# release artifacts, and fill in the real values.
#
# Generate an upload keystore once and keep it OUTSIDE the repo:
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#     -alias upload -keyalg RSA -keysize 2048 -validity 9125
#
# storeFile is resolved relative to the repo root.

storeFile=../upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
